%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_embedder.
%%
%% Multilingual sentence embeddings as a mesh procedure, for callers that cannot run the ONNX model themselves
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. No store: the service module
    %% exports no store_id/0 + data_dir/0. 0.27 labels the boot claim with
    %% MCL_SERVICE_NAME / MCL_BOX, which the realm's Providers desk shows, and
    %% no longer brings barrel_docdb or rocksdb.
    {mcl_om, "~> 0.27"},
    %% The embedder itself: a Rust NIF over fastembed/ONNX, compiled from
    %% source by mcl_embed's own hooks. CARGO_FEATURES=real-embed in the build
    %% environment selects the real model; the image sets it.
    {mcl_embed, "~> 0.1.1"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% serve_embed implements `macula_response', but macula comes in only through
%% mcl_om, so it is not in the PLT unless it is named here: dialyzer would find
%% the behaviour's callbacks unavailable.
{dialyzer, [{plt_extra_apps, [macula]}]}.

{relx, [
    {release, {mcl_embedder, "0.1.0"}, [mcl_embedder, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
